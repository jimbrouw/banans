{
  "name": "roughcut-premiere-uxp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/finalize-uxp-build.mjs",
    "build:uxp": "npm run build",
    "lint": "eslint .",
    "test": "vitest run",
